# Dependencies and build output. Both are produced inside the model images
# (see Dockerfile), so they never need to live in git.
node_modules/
dist/
dist-ssr/
.vite/

# Local env / logs / OS noise
*.local
*.log
.DS_Store

# Scratch output from screenshot tooling
.shots/

# Python leftovers (deepseek-v4-flash-0731-coreweave/fix.py)
__pycache__/
*.pyc

# Local tool state
.freebuff/

# Caddy runtime state if it is ever mounted locally
data/

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
site-packages/
venv/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
