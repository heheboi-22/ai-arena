{
  "name": "pocket-world",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pocket World: an interactive 3D floating-island diorama built with Three.js, Vite, and TypeScript.",
  "scripts": {
    "dev": "vite",
